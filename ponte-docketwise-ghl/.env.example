# ─── Docketwise (API v1, OAuth 2.0) ────────────────────────────────
# Liberado sob pedido: e-mail para dev@docketwise.com, assunto
# "API integration", informando a redirect URI abaixo.
DOCKETWISE_CLIENT_ID=
DOCKETWISE_CLIENT_SECRET=
DOCKETWISE_REDIRECT_URI=https://SEU-DOMINIO/api/oauth/callback

# Formato do corpo aceito pela API: "contact" manda {"contact": {...}} (padrao
# Rails), "flat" manda os campos na raiz. Se o primeiro POST voltar 400/422,
# troque aqui — o corpo do erro sai inteiro no log da funcao.
DOCKETWISE_PAYLOAD_ENVELOPE=contact

# Preenchido = todo contato novo tambem abre um matter desse tipo.
# Vazio = so cria o contato. Pegue o id em GET /api/v1/matter_types.
DOCKETWISE_MATTER_TYPE_ID=

# ─── GoHighLevel (API v2) ──────────────────────────────────────────
# Settings -> Private Integrations. Escopos: contacts.readonly,
# contacts.write, opportunities.write.
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
# Campo personalizado do GHL onde a ponte grava o id do contato do Docketwise
GHL_CF_DOCKETWISE_ID=
GHL_TAG_SUCESSO=docketwise-ok
GHL_PREFIXO_TAG_CASO=caso

# ─── Seguranca da ponte ────────────────────────────────────────────
# Segredo do webhook. Vai no header x-ponte-token do Custom Webhook do GHL.
# Sem ele a rota recusa tudo.  openssl rand -hex 32
PONTE_WEBHOOK_SECRET=
# Protege /api/oauth/start, /api/status e a execucao manual do cron
PONTE_ADMIN_TOKEN=
# Gerado pelo proprio Vercel quando ha cron configurado
CRON_SECRET=

# ─── Persistencia (Upstash Redis via REST) ─────────────────────────
# Guarda o refresh token e o marcador da varredura. SEM ISSO a ponte perde a
# autorizacao do Docketwise a cada cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
