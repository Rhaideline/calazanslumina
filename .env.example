# ─── Tracking & Analytics ──────────────────────────────────────────
# Cole o ID exato do Meta Pixel (16 digitos) e GA4 (G-XXXXXXXXXX).
# Estes envs sao PUBLIC (NEXT_PUBLIC_) porque os scripts rodam no browser.
# Se um campo ficar vazio, o tracking respectivo nao carrega — site funciona normal.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ─── GHL API (server-side, secret) ─────────────────────────────────
# Usados em /api/preview-request pra criar contato no GHL.
GHL_PIT_TOKEN=
GHL_LOCATION=

# ─── Claude API (server-side, secret) ──────────────────────────────
# Usados em /api/claude, a ponte que os workflows do GHL chamam.
# ANTHROPIC_API_KEY: console.anthropic.com -> API Keys.
# CLAUDE_WEBHOOK_SECRET: string aleatoria que voce inventa. O mesmo valor vai
# no header x-webhook-secret da acao Webhook do workflow. Sem ele, quem
# descobrir a URL da rota gasta os creditos da Anthropic.
ANTHROPIC_API_KEY=
CLAUDE_WEBHOOK_SECRET=
